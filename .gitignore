output/cache/
*.slxc
*.asv
slprj/

# Local recovery archives
backup/

# External datasets: raw records are re-fetchable, not committed
data/external/*/raw/
data/external/**/electrode_img*.jpg

# In-progress sweep checkpoints: superseded by the completed CSV beside them
output/results/*.partial.csv

# Per-case benchmark traces (~260 MB, regenerated by START_PROJECT('benchmark'))
output/results/control_case_*.mat
output/results/strong_soup_*.mat

# Windows / Office lock files and OS junk
~$*
Thumbs.db
desktop.ini
.DS_Store

# Machine-specific tooling config (see .mcp.json.example)
.mcp.json
.claude/

# Private reviewer feedback and scratch material
EXPLANATION/Rough Images/
EXPLANATION/Report QnA - Reviewer Points.md

# Raw third-party downloads
data/external/*/raw/

# Root-level copy of the presentation (the tracked one lives in reports/)
/*.pptx
